rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ==========================================
    // Permissões Globais (Collection Groups)
    // Essencial para o sistema multi-rede e Permissões do painel funcionar
    // ==========================================
    match /{path=**}/units/{unit} {
      allow read: if request.auth != null;
    }

    match /{path=**}/trainings/{training} {
      allow read: if request.auth != null;
    }
    
    // ==========================================
    // Tabelas Essenciais
    // ==========================================
    match /user_roles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    
    // ==========================================
    // Progressão do Currículo (Treinamentos)
    // ==========================================
    match /users/{userId}/training_progress/{trainingId} {
       allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/training_steps/{stepId} {
       allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ==========================================
    // Treinamentos (Rede base)
    // ==========================================
    match /networks/{networkId}/trainings/{trainingId} {
       allow read: if request.auth != null;
       allow write: if request.auth != null; // Restringir idealmente p/ Super Admins via token ou role futuro
       
       match /videos/{videoId} {
          allow read, write: if request.auth != null;
       }
       match /steps/{stepId} {
          allow read, write: if request.auth != null;
       }
    }
  }
}
